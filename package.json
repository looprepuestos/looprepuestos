{
  "name": "loop-repuestos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:catalog": "tsx scripts/import-catalog.ts",
    "sync:sheets": "tsx scripts/sync-sheets.ts",
    "test:mapper": "tsx scripts/tests/mapper.test.mts",
    "test:snapshot": "node scripts/tests/catalog-snapshot.test.mjs",
    "test:sql": "bash supabase/tests/run.sh",
    "build:cloudflare": "CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run",
    "types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "@vercel/analytics": "^2.0.1",
    "google-auth-library": "^9.15.1",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "4.152.0"
  }
}
